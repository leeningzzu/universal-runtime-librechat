+describe('createLoadConfigModels – ChatAnywhere user catalogue durability', () => {
+  const fetchModels = jest.fn().mockResolvedValue(['catalog-a', 'catalog-b']);
+
+  beforeEach(() => {
+    fetchModels.mockReset().mockResolvedValue(['catalog-a', 'catalog-b']);
+  });
+
+  const loadUserEndpoint = async (name: string) => {
+    const loadConfigModels = createLoadConfigModels({
+      getAppConfig: jest.fn().mockResolvedValue({
+        endpoints: {
+          [EModelEndpoint.custom]: [
+            {
+              name,
+              baseURL: 'https://admin-trusted.example.com/v1',
+              apiKey: AuthType.USER_PROVIDED,
+              models: { fetch: true, default: ['verified-fallback'] },
+            },
+          ],
+        },
+      }),
+      getUserKeyValues: jest.fn().mockResolvedValue({ apiKey: 'sk-user-key' }),
+      fetchModels,
+    });
+    return loadConfigModels({ user: { id: 'user-1' } } as unknown as ServerRequest);
+  };
+
+  it('uses a bounded longer timeout and credential-fingerprinted cache for ChatAnywhere', async () => {
+    const models = await loadUserEndpoint('ChatAnywhere');
+    expect(models.ChatAnywhere).toEqual(['catalog-a', 'catalog-b']);
+    expect(fetchModels).toHaveBeenCalledWith(
+      expect.objectContaining({
+        name: 'ChatAnywhere',
+        skipCache: false,
+        timeoutMs: 20000,
+        cacheTtl: 600000,
+      }),
+    );
+  });
+
+  it('preserves the native no-cache and five-second policy for other user-provided endpoints', async () => {
+    await loadUserEndpoint('OtherUserEndpoint');
+    expect(fetchModels).toHaveBeenCalledWith(
+      expect.objectContaining({
+        name: 'OtherUserEndpoint',
+        skipCache: true,
+        timeoutMs: 5000,
+        cacheTtl: 120000,
+      }),
+    );
+  });
+});
