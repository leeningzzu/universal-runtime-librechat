+async function proxyRuntimeUserInstallablePacks(req, res) {
+  const { projectId } = req.params;
+  if (!isValidObjectIdString(projectId)) {
+    return res.status(404).json({ error: 'Project not found' });
+  }
+  const project = await db.getChatProject(getUserId(req), projectId);
+  if (!project) {
+    return res.status(404).json({ error: 'Project not found' });
+  }
+  const key = String(process.env.UR_SHELL_ADAPTER_KEY || '');
+  if (!key) {
+    return res.status(503).json({ error: 'Installed Pack lifecycle unavailable' });
+  }
+  try {
+    const response = await fetch(`${RUNTIME_ADAPTER_BASE}/v1/runtime-user-installable-packs`, {
+      method: 'GET',
+      headers: {
+        Accept: 'application/json',
+        Authorization: `Bearer ${key}`,
+        'X-LibreChat-Project-ID': projectId,
+      },
+    });
+    const raw = await response.text();
+    res.set('Cache-Control', 'no-store');
+    res.type('application/json');
+    return res.status(response.status).send(raw || '{}');
+  } catch (_) {
+    return res.status(502).json({ error: 'Installed Pack catalog bridge unavailable' });
+  }
+}
+
+async function proxyRuntimeUserPackInstall(req, res, method) {
+  const { projectId } = req.params;
+  if (!isValidObjectIdString(projectId)) {
+    return res.status(404).json({ error: 'Project not found' });
+  }
+  const project = await db.getChatProject(getUserId(req), projectId);
+  if (!project) {
+    return res.status(404).json({ error: 'Project not found' });
+  }
+  const packId = typeof req.body?.pack_id === 'string' ? req.body.pack_id.trim() : '';
+  const packVersion = typeof req.body?.pack_version === 'string' ? req.body.pack_version.trim() : '';
+  const commandId = typeof req.body?.command_id === 'string' ? req.body.command_id.trim() : '';
+  if (!packId || !packVersion || (method === 'DELETE' && !commandId)) {
+    return res.status(400).json({ error: 'Exact Pack identity and uninstall command are required' });
+  }
+  const key = String(process.env.UR_SHELL_ADAPTER_KEY || '');
+  if (!key) {
+    return res.status(503).json({ error: 'Installed Pack lifecycle unavailable' });
+  }
+  try {
+    const response = await fetch(`${RUNTIME_ADAPTER_BASE}/v1/runtime-user-pack-install`, {
+      method,
+      headers: {
+        Accept: 'application/json',
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${key}`,
+        'X-LibreChat-Project-ID': projectId,
+      },
+      body: JSON.stringify({
+        pack_id: packId,
+        pack_version: packVersion,
+        ...(method === 'DELETE' ? { command_id: commandId } : {}),
+      }),
+    });
+    const raw = await response.text();
+    res.set('Cache-Control', 'no-store');
+    res.type('application/json');
+    return res.status(response.status).send(raw || '{}');
+  } catch (_) {
+    return res.status(502).json({ error: 'Installed Pack lifecycle bridge unavailable' });
+  }
+}
