{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultPackage",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "outputs"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "REVISE",
        "BLOCKER",
        "ERROR"
      ]
    },
    "outputs": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
