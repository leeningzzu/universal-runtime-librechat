{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Universal Runtime Bootstrap Acceptance Report v1",
  "type":"object", "additionalProperties":false,
  "required":["report_version","task_id","spec_sha256","pre_state_sha256","harness_revision_sha256","toolchain_fingerprint_sha256","bootstrap_policy_revision","idempotency_key","harness_self_test_result","harness_self_test_receipt_sha256","runtime_acceptance_result","partition_integrity","combined_totals","result","network_policy","model_call_policy"],
