{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "General Chat Text Reply Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "response_kind": {
      "const": "text_reply_proposal"
    },
    "assistant_text": {
